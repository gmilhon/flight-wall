# Flight Wall configuration — copy to `.env` for local dev (optional).
# Every value has a sensible default; you can run with no env at all.

# Port the server listens on.
PORT=8080

# Protect settings writes (the control panel) with a PIN.
# Leave empty to allow anyone with the URL to change the display.
CONTROL_PIN=

# Storage backend: firestore | file | memory
# Default: "file" locally, "firestore" automatically on Cloud Run.
# STORAGE=file

# Firestore project (auto-detected on Cloud Run; only needed to override).
# GOOGLE_CLOUD_PROJECT=your-project-id

# Where the "file" backend stores settings locally.
# DATA_DIR=./data
